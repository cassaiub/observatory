# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Large Astrometry.net index files (download separately; point to via config)
astrometry_data/

# Workshop dataset (distributed separately -- see workshop/README.md)
workshop/raw/

# Pipeline run outputs: one directory per phase under a work directory
work/
phase1/
phase2/
phase3/
phase4/
Run[0-9]*/
*_fluxcal.fits
*_segmap.fits
*_catalog.csv
calibrated_*.fits
Master_*.fits

# Notebook / LaTeX build artifacts
.ipynb_checkpoints/
*.aux
*.log
*.out
*.fdb_latexmk
*.fls
*.nav
*.snm
*.toc
*.vrb
*.synctex.gz

# Environments created by install.sh
.venv/
.ruff_cache/

# Simulated datasets (regenerate with: cassa-simulate --preset workshop)
sim/

# Instructor-only preparation notes. Not for participants, and deliberately not
# in the repository: they carry the answers, the traps, a frank assessment of
# this night's data, and the words to say out loud. Keep them local, or
# circulate them out of band.
workshop/slides/instructor_briefing.*
workshop/slides/lecture_script.*

# Internal engineering plans. Kept out of the repository because they are
# working documents for whoever develops the pipeline, not reference material
# for the people who run it: they carry defect audits, work-package checklists
# and frank assessments of code that has since been fixed. Users are served by
# the three documents that ARE tracked: REFERENCE.md (every command, config key,
# keyword and function), CUSTOMIZING.md (how to configure and extend a run) and
# CHANGELOG.md (what changed, and what it means for existing data).
docs/master-plan.md
docs/step-plan.md
docs/target-driven-photometry-plan.md
docs/astrometry-index-plan.md
docs/astap-backend-plan.md
