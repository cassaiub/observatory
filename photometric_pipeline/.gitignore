# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Large Astrometry.net index files (download separately; point to via config)
astrometry_data/

# Pipeline run outputs: one directory per phase under a work directory
work/
phase1/
phase2/
phase3/
phase4/
Run[0-9]*/
*_fluxcal.fits
*_segmap.fits
*_catalog.csv
calibrated_*.fits
Master_*.fits

# Notebook / LaTeX build artifacts
.ipynb_checkpoints/
*.aux
*.log
*.out
*.fdb_latexmk
*.fls
*.nav
*.snm
*.toc
*.vrb
*.synctex.gz

# Environments created by install.sh
.venv/
.ruff_cache/

# Simulated datasets (regenerate with: cassa-simulate --preset workshop)
sim/

# Instructor-only preparation notes. Not for participants, and deliberately not
# in the repository: they carry the answers, the traps, a frank assessment of
# this night's data, and the words to say out loud. Keep them local, or
# circulate them out of band.
workshop/slides/instructor_briefing.*
workshop/slides/lecture_script.*

# Development scaffolding, deliberately not shipped. The repository carries what
# a user needs to run the pipeline -- source, config, the compiled manual and
# the workshop dataset -- and not the machinery used to build and check it.
#
# docs/            the markdown reference set; the compiled manual is shipped
#                  instead, and the internal engineering plans were never
#                  tracked
# tests/           the suite (500+ tests); still run locally and in a checkout
# .github/         CI configuration
docs/
tests/
.github/
